        "eslint-plugin-react": "^7.26.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.3.0",
        "minimist": "^1.2.6",
        "prettier": "^3.6.2",
        "rollup": "^4.12.0",
        "rollup-plugin-bd-meta": "*",
        "rollup-plugin-bd-wscript": "*",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-sass": "^1.15.3",
        "rollup-plugin-scss": "^4.0.1",
        "rollup-plugin-style-modules": "*",
        "sass": "^1.43.4",
        "tslib": "^2.6.2",
